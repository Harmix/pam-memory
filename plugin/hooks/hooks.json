{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "pam-memory-session-start",
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" --event session_start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "pam-memory-user-prompt",
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" --event user_prompt",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
